{
  "name": "santo-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional + ERP (Portal do Funcionário, Portal do Cliente, Painel Administrativo) da Santo Serviços Terceirizados",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase migration up",
    "supabase:gen-types": "supabase gen types typescript --local > src/types/database.types.ts",
    "seed": "tsx supabase/seed/run.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "@supabase/supabase-js": "^2.46.1",
    "@supabase/ssr": "^0.5.2",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.8",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.451.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "next-themes": "^0.4.3",
    "date-fns": "^4.1.0",
    "recharts": "^2.13.0",
    "pdf-lib": "^1.17.1",
    "exceljs": "^4.4.0",
    "signature_pad": "^5.0.4",
    "sonner": "^1.5.0",
    "cpf-cnpj-validator": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "^1.219.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "@testing-library/react": "^16.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
